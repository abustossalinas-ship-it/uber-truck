PORT=3001
NODE_ENV=development

# Supabase — proyecto uber-truck (ref: ljinhegtywixtbzjgjfn)
# Dashboard: https://supabase.com/dashboard/project/ljinhegtywixtbzjgjfn
# Settings → API → service_role (solo servidor, nunca en el front)
SUPABASE_URL=https://ljinhegtywixtbzjgjfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Railway — proyecto NUEVO "uber-truck" (NO wa-fintech-mvp)
# Ver docs/DEPLOY.md para variables en producción

# Auth / JWT (futuro)
# JWT_SECRET=

# Google Maps (Places + Distance Matrix) — restricción por IP/referrer en Google Cloud
# Habilitar: Places API, Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=

# Auth MVP (requiere migración 003 en Supabase)
JWT_SECRET=cambiar-por-secreto-largo-aleatorio

# URL pública de la app (enlaces de recuperación de contraseña)
APP_PUBLIC_URL=https://uber-truck-production.up.railway.app

# Correo — recuperación de contraseña (https://resend.com)
# RESEND_API_KEY=
# EMAIL_FROM=Uber Truck <noreply@tudominio.cl>

# Crear cuenta admin (POST /api/auth/register con role=admin y admin_key)
# ADMIN_REGISTER_KEY=

# Cargar datos demo en producción: POST /api/demo/seed con header X-Demo-Seed-Key
# DEMO_SEED_KEY=

# Marketplace semi-curado: en producción solo cuentas kyc_status=approved operan
# KYC_ENFORCE=true
# KYC_ENFORCE=false

# Multas sugeridas: días de gracia antes de bloquear nuevas operaciones
# PENALTY_DUE_DAYS=7
# Horas para que el acreedor confirme un pago declarado por el deudor
# PENALTY_CONFIRM_HOURS=24
