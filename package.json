{
  "name": "uber-truck",
  "version": "0.0.126",
  "private": true,
  "description": "Cubik — marketplace cubicación logística (repo uber-truck)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "export:memoria-docx": "node scripts/export-memoria-docx.cjs",
    "export:all-docs": "node scripts/export-all-docs-docx.cjs",
    "cap:sync": "node scripts/cap-config-bundle.cjs && node scripts/generate-android-icons.cjs && npx cap sync android",
    "cap:open:android": "npm run cap:sync:bundle && npx cap open android",
    "cap:icons": "node scripts/generate-android-icons.cjs && npm run cap:sync",
    "cap:sync:remote": "node scripts/cap-config-remote.cjs && node scripts/generate-android-icons.cjs && npx cap sync android",
    "cap:sync:bundle": "node scripts/cap-config-bundle.cjs && node scripts/generate-android-icons.cjs && npx cap sync android",
    "android:apk": "node scripts/build-android-apk.cjs",
    "android:apk:remote": "node scripts/build-android-apk.cjs --remote",
    "android:apk:bundle": "node scripts/build-android-apk.cjs --bundle",
    "android:aab:remote": "node scripts/build-android-aab-remote.cjs",
    "android:install": "node scripts/install-android-emulator.cjs",
    "android:install:remote": "node scripts/install-android-emulator.cjs --remote",
    "android:verify": "node scripts/verify-android-bundle.cjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.js",
    "test:qa": "node scripts/run-qa.cjs",
    "test:qa:prod": "node scripts/run-qa.cjs --prod",
    "test:e2e:ui": "playwright test --ui",
    "qa:install": "playwright install chromium",
    "qa:catalog": "node scripts/build-qa-catalog.cjs",
    "qa:lab": "node scripts/open-qa-lab.cjs",
    "qa:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.106.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "html-to-docx": "^1.8.0",
    "nodemon": "^3.1.0",
    "@playwright/test": "^1.52.0",
    "sharp": "^0.34.2"
  }
}
