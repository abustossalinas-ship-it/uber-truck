PORT=3001
NODE_ENV=development

# Supabase — proyecto uber-truck (ref: ljinhegtywixtbzjgjfn)
# Dashboard: https://supabase.com/dashboard/project/ljinhegtywixtbzjgjfn
# Settings → API → service_role (solo servidor, nunca en el front)
SUPABASE_URL=https://ljinhegtywixtbzjgjfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Railway — proyecto NUEVO "uber-truck" (NO wa-fintech-mvp)
# Ver docs/DEPLOY.md para variables en producción

# Auth / JWT (futuro)
# JWT_SECRET=

# Google Maps — servidor: Places, Distance Matrix, Static (restricción IP Railway)
# Navegador/APK: Maps JavaScript API (restricción HTTP referrer)
# Habilitar en Google Cloud: Places, Distance Matrix, Maps Static, Maps JavaScript, Directions
GOOGLE_MAPS_API_KEY=
# Opcional: clave solo para mapa en vivo en web/APK (recomendado en prod)
# Referrers: https://uber-truck-production.up.railway.app/*  http://localhost:*  https://localhost/*
GOOGLE_MAPS_BROWSER_KEY=

# Auth MVP (requiere migración 003 en Supabase)
JWT_SECRET=cambiar-por-secreto-largo-aleatorio

# URL pública de la app (enlaces de recuperación de contraseña)
APP_PUBLIC_URL=https://uber-truck-production.up.railway.app

# Correo — recuperación de contraseña (https://resend.com)
# RESEND_API_KEY=
# EMAIL_FROM=Uber Truck <noreply@tudominio.cl>

# --- Pendiente producción (bloque E): login Gmail + Apple ---
# Google OAuth — Cloud Console → APIs & Services → Credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Apple Sign In — developer.apple.com (Services ID, Key, Team ID)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=
# Ver docs/AUTH-AND-EMAIL-ROADMAP.md

# Crear cuenta admin (POST /api/auth/register con role=admin y admin_key)
# ADMIN_REGISTER_KEY=

# Cargar datos demo en producción: POST /api/demo/seed con header X-Demo-Seed-Key
# DEMO_SEED_KEY=

# Marketplace semi-curado: en producción solo cuentas kyc_status=approved operan
# KYC_ENFORCE=true
# KYC_ENFORCE=false

# Multas sugeridas: días de gracia antes de bloquear nuevas operaciones
# PENALTY_DUE_DAYS=7
# Horas para que el acreedor confirme un pago declarado por el deudor
# PENALTY_CONFIRM_HOURS=24

# Cuenta bancaria obligatoria para operar (activo en producción por defecto)
# BANK_ENFORCE=true
# BANK_ENFORCE=false

# Tamaño máximo comprobante transferencia (bytes, base64 en BD)
# PAYMENT_PROOF_MAX_BYTES=1800000

# --- Pasarela tarjeta ---
# sandbox = piloto (RUT + Luhn, cargo simulado)
# mercadopago = producción real (requiere claves MP)
# PAYMENT_PROVIDER=sandbox
# PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# PAYMENT_MICROCHARGE_CLP=990
# PAYMENT_ALLOW_SANDBOX=true

# --- QA automatizado (Playwright + Node test) ---
# npm run qa:install   # una vez: Chromium para E2E
# npm run test:unit    # lógica GPS / proximidad
# npm run test:e2e     # welcome + login app (?app=1)
# npm run test:qa      # unit + e2e
# Opcional login real en E2E:
# QA_CARRIER_EMAIL=
# QA_CARRIER_PASSWORD=
# FCM_SERVICE_ACCOUNT_B64=    # base64 del JSON service account (recomendado en Railway)
# FCM_SERVICE_ACCOUNT_JSON=   # alternativa: JSON en una línea (node scripts/encode-fcm-service-account.cjs)
# FCM_SERVER_KEY=             # legacy server key (alternativa)

# --- Llamadas enmascaradas (modelo Uber / Twilio Proxy) ---
# Número proxy Cubik que conecta embarcador ↔ transportista sin mostrar teléfonos reales.
# Cuando esté configurado, el botón «Llamar» del viaje usa tel: a este número.
# TWILIO_MATCH_PROXY_NUMBER=+5622XXXXXXX
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Sugerencia flete publicar carga (src/lib/match-price.js) ---
# Calibrado corredor RM–V jun 2026 (antes: 120k + 750/km + 45/kg)
# BUDGET_BASE_CLP=80000
# BUDGET_RATE_KM_CLP=450
# BUDGET_RATE_KG_CLP=22
# BUDGET_URGENT_MULT=1.18
# BUDGET_MIN_RATIO=0.82
# BUDGET_MAX_RATIO=1.25
