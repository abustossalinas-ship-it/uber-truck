{
  "appId": "cl.cubik.logistics",
  "appName": "Cubik",
  "webDir": "public",
  "server": {
    "url": "https://uber-truck-production.up.railway.app",
    "androidScheme": "https",
    "allowNavigation": [
      "uber-truck-production.up.railway.app",
      "*.up.railway.app"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2200,
      "launchAutoHide": true,
      "backgroundColor": "#F4F7FB",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f2744"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
